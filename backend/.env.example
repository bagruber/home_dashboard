# Copy this file to backend/.env and fill in real values. .env is gitignored.
# Each variable is optional — services without their credentials degrade gracefully.

# 17TRACK (api.17track.net) — multi-carrier parcel tracking, free one-time
# quota of ~200 numbers. Handles DHL/Hermes/DPD/GLS/UPS/Amazon; preferred.
DASHBOARD_17TRACK_API_KEY=

# DHL "Shipment Tracking - Unified" — business accounts only; unnecessary
# when 17TRACK is configured.
# DASHBOARD_DHL_API_KEY=

# Self-hosted db-rest instance (removes train rate limits)
# DASHBOARD_DB_REST_BASE_URL=http://localhost:3000

# Mercedes me Connect — wire later (planned)
# DASHBOARD_MB_CLIENT_ID=
# DASHBOARD_MB_CLIENT_SECRET=
# DASHBOARD_MB_VIN=
